CREATE DATABASE IF NOT EXISTS controle_vacinas_goias;
USE controle_vacinas_goias;

CREATE TABLE Pacientes (
    id_paciente INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    idade INT NOT NULL,
    escolaridade VARCHAR(50),
    regiao_moradia VARCHAR(100)
);

CREATE TABLE Vacinas (
    id_vacina INT AUTO_INCREMENT PRIMARY KEY,
    nome_vacina VARCHAR(50) NOT NULL,
    fabricante VARCHAR(50) NOT NULL,
    lote VARCHAR(30) NOT NULL,
    faixa_etaria_indicada VARCHAR(50)
);

CREATE TABLE Doencas (
    id_doenca INT AUTO_INCREMENT PRIMARY KEY,
    nome_doenca VARCHAR(50) NOT NULL,
    agente_etiologico VARCHAR(50)
);

CREATE TABLE Aplicacoes_Vacinas (
    id_aplicacao INT AUTO_INCREMENT PRIMARY KEY,
    id_paciente INT,
    id_vacina INT,
    data_aplicacao DATE NOT NULL,
    dose VARCHAR(20) NOT NULL,
    FOREIGN KEY (id_paciente) REFERENCES Pacientes(id_paciente) ON DELETE CASCADE,
    FOREIGN KEY (id_vacina) REFERENCES Vacinas(id_vacina) ON DELETE CASCADE
);

CREATE TABLE Registros_Casos (
    id_caso INT AUTO_INCREMENT PRIMARY KEY,
    id_paciente INT,
    id_doenca INT,
    data_diagnostico DATE NOT NULL,
    gravidade VARCHAR(20),
    FOREIGN KEY (id_paciente) REFERENCES Pacientes(id_paciente) ON DELETE CASCADE,
    FOREIGN KEY (id_doenca) REFERENCES Doencas(id_doenca) ON DELETE CASCADE
);
